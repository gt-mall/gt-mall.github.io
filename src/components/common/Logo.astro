---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="brand-mark" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none">
    <path
      d="M7 11h18l2 16H5l2-16Z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    />
    <path
      d="M11 12V9a5 5 0 0 1 10 0v3M12 18l3 3 5-6"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>
{!compact && (
  <span class="brand-name">
    GT<span>-</span>Shop<span class="brand-dot">.</span>
  </span>
)}
