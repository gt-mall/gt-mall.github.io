---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/common/Icon.astro";
import CodeBlock from "@/components/common/CodeBlock.astro";
import { site, withBase, sourceLink, features, docPages } from "@/data/site";
const showcases = [
  {
    id: "products",
    name: "商品管理",
    image: "product-management.png",
    width: 1269,
    height: 527,
    title: "把商品运营，放进一个清晰的工作台。",
    description:
      "名称、分类、SKU、品牌、价格与库存，多维筛选快速定位商品。让日常维护少一点翻找，多一点专注。",
    tags: ["多条件筛选", "商品上下架", "统一列表布局"],
    alt: "GT-Shop 商品管理页面，展示商品名称、分类、状态及更多筛选条件",
  },
  {
    id: "sku",
    name: "SKU 与规格",
    image: "sku-management.png",
    width: 1428,
    height: 590,
    title: "每一种规格，都有自己的价格与库存。",
    description:
      "按规格组合维护 SKU，把商品信息与库存管理连接起来，为选购、下单和后续运营提供一致的数据。",
    tags: ["规格组合", "独立 SKU", "库存管理"],
    alt: "GT-Shop 多规格商品与 SKU 管理界面",
  },
];
const faqs = [
  {
    question: "GT-Shop 适合什么项目？",
    answer:
      "适合需要自建商品、库存、订单与售后流程的团队，也适合作为 Go + React + UniApp 全栈学习和二次开发的基础。代码按业务领域组织，可以沿着具体需求扩展。",
  },
  {
    question: "开源版可以用于商业项目吗？",
    answer:
      "项目使用 Apache License 2.0，允许在遵守协议条件的前提下使用、修改和分发，包括商业用途。分发时请保留协议及相关声明；具体条款以仓库 LICENSE 为准。",
  },
  {
    question: "AI 能力现在可以做什么？",
    answer:
      "仓库已经提供 Go 后端、React 管理端和 UniApp 用户端的项目 Skills，可供支持 Skills 的 AI 编码助手参考。用户画像、优惠券推荐和个性化定价仍在开发中，尚未提供完整业务流程。",
  },
  {
    question: "微信支付需要额外配置吗？",
    answer:
      "需要。当前接入普通商户的小程序支付，需准备小程序、已绑定的微信支付商户、支付密钥与证书、公网 HTTPS 回调地址，并通过真机付款和退款验收。详细步骤见部署文档和仓库支付指南。",
  },
  {
    question: "必须安装 Redis 吗？",
    answer:
      "Redis 是可选的缓存组件。后端示例配置默认关闭 Redis，可先使用 MySQL 启动业务；需要缓存时再配置并开启。缓存异常时，商品读取有数据库回源路径。",
  },
  {
    question: "遇到问题或希望贡献代码怎么办？",
    answer:
      "可以在 GitHub Issues 提交问题和建议，附上版本、运行环境、复现步骤和脱敏日志。贡献前阅读项目架构和 API 契约，完成相关构建与测试后提交 Pull Request。",
  },
];
